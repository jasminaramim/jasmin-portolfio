# ========================================================
# JASMIN PORTFOLIO & DIGITAL MARKETPLACE - ENVIRONMENT CONFIG
# ========================================================

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ssmpl.mongodb.net/portfolio?retryWrites=true&w=majority

# Admin Authentication Secret Key (JWT)
JWT_SECRET=jasmin_premium_secret_key_123

# Customer Authentication Secret Key (JWT)
CUSTOMER_JWT_SECRET=jasmin_store_customer_secret_key_456

# Server Port
PORT=3000

# Bangladesh Payment Gateway (SSLCOMMERZ / aamarPay)
# When ready for live production transactions, set credentials below:
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Cloudinary Storage Configuration (Optional for cloud image CDN)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
